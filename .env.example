# ==========================================================================
# Variables utilisées par docker-compose.yml
#
# Copiez ce fichier en ".env" (cp .env.example .env) à la racine du projet
# puis ajustez les valeurs si besoin. Toutes les variables ont une valeur
# par défaut : "docker compose up --build" fonctionne même sans créer ce
# fichier, mais changez au minimum JWT_SECRET avant un usage réel.
# ==========================================================================

# --- Base de données PostgreSQL (conteneur "db") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=management_app

# --- Ports exposés sur la machine hôte ---
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000

# --- Backend ---
# Obligatoire pour un usage réel : générez une valeur forte,
# ex : openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_URL=http://localhost:3000
# false par défaut : ne renvoyez le lien de réinitialisation dans la réponse
# API (au lieu de l'envoyer par email) qu'en local/démo, jamais en production.
SHOW_RESET_LINK=false

# Emails transactionnels (Resend) - optionnel
RESEND_API_KEY=
EMAIL_FROM=Octostock <onboarding@resend.dev>

# Taux de change - optionnel
OPENEXCHANGERATES_API_KEY=

# --- Frontend ---
# URL publique de l'API, utilisée par le navigateur (doit rester joignable
# depuis la machine du client, pas seulement depuis le réseau Docker interne)
NEXT_PUBLIC_API_URL=http://localhost:3001
