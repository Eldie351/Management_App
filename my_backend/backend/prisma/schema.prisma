generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum MovementType {
  CREATION
  RECHARGE
  SALE
  ADJUSTMENT
}

enum Currency {
  XOF
  EUR
  USD
  GBP
  NGN
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String
  password       String
  role           UserRole        @default(ADMIN)
  resetTokenExp  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stores         Store[]
  resetToken     ResetToken?
  stockMovements StockMovement[]
  sales          Sale[]
  auditLogs      AuditLog[]
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id             Int             @id @default(autoincrement())
  name           String
  location       String?
  createdAt      DateTime        @default(now())
  currency       Currency        @default(XOF)
  userId         Int
  products       Product[]
  sales          Sale[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories     Category[]
  suppliers      Supplier[]
  stockMovements StockMovement[]
  notifications  Notification[]
}

model Product {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  sku           String?         @unique // 👈 CORRIGÉ : L'arobase est bien en place
  barcode       String?
  imageUrl      String?
  quantity      Int             @default(0)
  initialStock  Int             @default(0)
  minimumStock  Int             @default(5)
  purchasePrice Float
  sellingPrice  Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  storeId       Int
  store         Store           @relation(fields: [storeId], references: [id])
  categoryId    Int?
  category      Category?       @relation(fields: [categoryId], references: [id])
  supplierId    Int?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]
  sales         Sale[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  products    Product[]
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  storeId   Int
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  quantity  Int
  type      MovementType
  note      String?
  createdAt DateTime     @default(now())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  storeId   Int
  store     Store        @relation(fields: [storeId], references: [id])

  @@index([productId])
  @@index([storeId])
}

model Sale {
  id          Int      @id @default(autoincrement())
  unitPrice   Float
  total       Float
  quantity    Int
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])

  @@index([productId])
  @@index([storeId])
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @db.VarChar(3)
  toCurrency   String   @db.VarChar(3)
  rate         Float
  source       String   @default("OPENEXCHANGERATES") @db.VarChar(50)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}
