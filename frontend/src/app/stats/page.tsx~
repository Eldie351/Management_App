'use client';

import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import Sidebar from '@/components/Sidebar';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';

export default function StatsPage() {
  const router = useRouter();
  const [profile, setProfile] = useState<any>(null);
  const [selectedStoreId, setSelectedStoreId] = useState<string>('');
  const [stats, setStats] = useState<any>(null);
  const [timeframe, setTimeframe] = useState<'day' | 'month' | 'year'>('month');
  const [loading, setLoading] = useState(true);

  // Charger la liste des magasins de l'utilisateur
  useEffect(() => {
    const token = localStorage.getItem('access_token');
    if (!token) {
      router.push('/login');
      return;
    }

    fetch('http://localhost:3000/auth/profil', {
      method: 'GET',
      headers: { 'Authorization': `Bearer ${token}` },
    })
      .then((res) => res.json())
      .then((data) => {
        setProfile(data);
        if (data.stores?.length > 0) {
          setSelectedStoreId(data.stores[0].id.toString());
        }
        setLoading(false);
      })
      .catch(() => router.push('/login'));
  }, [router]);

  // Charger les statistiques dès que le magasin sélectionné change
  useEffect(() => {
    if (!selectedStoreId) return;
    const token = localStorage.getItem('access_token');

    fetch(`http://localhost:3000/stores/${selectedStoreId}/stats`, {
      method: 'GET',
      headers: { 'Authorization': `Bearer ${token}` },
    })
      .then((res) => res.json())
      .then((data) => setStats(data))
      .catch((err) => console.error(err));
  }, [selectedStoreId]);

  if (loading) return <div className="flex h-screen items-center justify-center">Analyse des indicateurs...</div>;

  // Sélectionner le jeu de données temporelles à afficher selon le filtre actif
  const activeChartData = 
    timeframe === 'day' ? stats?.daily : 
    timeframe === 'year' ? stats?.yearly : stats?.monthly;

  return (
    <div className="flex h-screen bg-gray-100">
      <Sidebar />

      <main className="flex-1 overflow-y-auto p-8">
        <div className="flex items-center justify-between border-b pb-4 mb-6">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Analyses & Statistiques</h1>
            <p className="text-muted-foreground mt-1">Visualisez les performances financières de vos stocks.</p>
          </div>
          
          {/* SÉLECTEUR DE MAGASIN */}
          <div className="flex items-center space-x-2">
            <label className="text-sm font-medium text-gray-700">Entrepôt :</label>
            <select 
              value={selectedStoreId} 
              onChange={(e) => setSelectedStoreId(e.target.value)}
              className="p-2 border rounded-lg bg-white shadow-sm font-medium outline-none border-gray-200 focus:border-blue-500"
            >
              {profile?.stores?.map((store: any) => (
                <option key={store.id} value={store.id}>{store.name}</option>
              ))}
            </select>
          </div>
        </div>

        {/* SECITON DES INDICATEURS CLÉS EN CHIFFRES */}
        <div className="grid gap-4 md:grid-cols-2 mb-8">
          <Card>
            <CardHeader className="pb-2">
              <CardTitle className="text-sm font-medium text-muted-foreground">Valeur Financière Actuelle</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="text-3xl font-bold text-blue-600">
                {stats?.summary?.totalValue?.toFixed(2) || '0.00'} €
              </div>
            </CardContent>
          </Card>
          <Card>
            <CardHeader className="pb-2">
              <CardTitle className="text-sm font-medium text-muted-foreground">Volume de Marchandises</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="text-3xl font-bold text-gray-800">
                {stats?.summary?.totalProducts || 0} unités en stock
              </div>
            </CardContent>
          </Card>
        </div>

        {/* GRAPHIQUE TEMPOREL AVEC FILTRES */}
        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-6">
            <div>
              <CardTitle>Évolution Logistique</CardTitle>
              <CardDescription>Valeur totale du stock estimée sur la période sélectionnée.</CardDescription>
            </div>
            
            {/* FILTRES TEMPORELS */}
            <div className="flex border rounded-lg overflow-hidden bg-gray-50 p-1 space-x-1">
              <Button size="sm" variant={timeframe === 'day' ? 'default' : 'ghost'} onClick={() => setTimeframe('day')}>Jour</Button>
              <Button size="sm" variant={timeframe === 'month' ? 'default' : 'ghost'} onClick={() => setTimeframe('month')}>Mois</Button>
              <Button size="sm" variant={timeframe === 'year' ? 'default' : 'ghost'} onClick={() => setTimeframe('year')}>Année</Button>
            </div>
          </CardHeader>
          <CardContent className="h-64 flex items-end justify-between px-12 pt-6 border-t">
            {/* Rendu visuel d'un graphique en barres CSS épuré et ultra-léger */}
            {activeChartData?.map((item: any, idx: number) => (
              <div key={idx} className="flex flex-col items-center flex-1 group h-full justify-end">
                <span className="text-xs font-semibold text-blue-600 mb-2 opacity-0 group-hover:opacity-100 transition-opacity">
                  {item.valeur.toFixed(0)}€
                </span>
                <div 
                  className="w-16 bg-blue-500 rounded-t-lg transition-all duration-500 group-hover:bg-blue-600" 
                  style={{ height: `${Math.max((item.valeur / (stats?.summary?.totalValue || 1)) * 70, 15)}%` }}
                />
                <span className="text-xs text-gray-500 mt-3 font-medium">{item.date}</span>
              </div>
            ))}
          </CardContent>
        </Card>
      </main>
    </div>
  );
}
