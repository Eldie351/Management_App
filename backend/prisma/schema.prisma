generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum Currency {
  XOF
  EUR
  USD
  GBP
  NGN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(ADMIN)
  resetToken      String?
  resetTokenExp   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stores    Store[]
}

model Store {
  id        Int       @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime  @default(now())
  currency  Currency  @default(XOF)
  userId    Int
  products  Product[]
  sales     Sale[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  quantity    Int      @default(0)
  initialStock Int      @default(0)
  sku         String?
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Sale {
  id          Int      @id @default(autoincrement())
  productName String
  sku         String?
  quantity    Int
  total       Float
  createdAt   DateTime @default(now())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  fromCurrency  String   @db.VarChar(3)
  toCurrency    String   @db.VarChar(3)
  rate          Float
  source        String   @default("OPENEXCHANGERATES") @db.VarChar(50)
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}
