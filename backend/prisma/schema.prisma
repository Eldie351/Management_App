generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum MovementType {
  CREATION
  RECHARGE
  SALE
  ADJUSTMENT
}

enum Currency {
  XOF
  EUR
  USD
  GBP
  NGN
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  password        String
  role            UserRole  @default(ADMIN)
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Traçabilité : Qui a créé ce compte
  createdById     Int?
  createdBy       User?     @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    User[]    @relation("UserCreator")

  // Magasins dont cet utilisateur est LE PROPRIÉTAIRE (Propriétaire Admin)
  ownedStores     Store[]   @relation("StoreOwner")

  // Magasin auquel cet utilisateur est AFFECTÉ (Caissier ou Manager)
  assignedStoreId Int?
  assignedStore   Store?    @relation("AssignedEmployees", fields: [assignedStoreId], references: [id], onDelete: SetNull)

  // Magasins supplémentaires ou multiples assignés via une relation explicite
  storeAssignments StoreAssignment[] @relation("UserStoreAssignments")

  resetToken      ResetToken?
  stockMovements  StockMovement[]
  sales           Sale[]
  auditLogs       AuditLog[]
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id             Int             @id @default(autoincrement())
  name           String
  location       String?
  phone          String?
  currency       Currency        @default(XOF)
  createdAt      DateTime        @default(now())

  // Propriétaire
  userId         Int
  owner          User            @relation("StoreOwner", fields: [userId], references: [id], onDelete: Cascade)

  // Employés rattachés (Caissiers, Managers)
  employees      User[]          @relation("AssignedEmployees")

  // Assignations de personnel supplémentaire ou multi-magasin
  assignedUsers  StoreAssignment[] @relation("StoreAssignments")

  products       Product[]
  sales          Sale[]
  categories     Category[]
  suppliers      Supplier[]
  stockMovements StockMovement[]
  notifications  Notification[]
}

model StoreAssignment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation("UserStoreAssignments", fields: [userId], references: [id], onDelete: Cascade)

  storeId   Int
  store     Store    @relation("StoreAssignments", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  sku           String?
  barcode       String?
  imageUrl      String?
  quantity      Int       @default(0)
  initialStock  Int       @default(0)

  // --- Seuils logistiques pour les alertes ---
  minimumStock  Int       @default(5)  // Seuil d'alerte de réapprovisionnement (WARNING)
  safetyStock   Int       @default(2)  // Seuil de sécurité / urgence absolue (CRITICAL)
  optimalStock  Int?                   // Stock cible idéal lors d'une commande
  // -------------------------------------------

  purchasePrice Float
  sellingPrice  Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements     StockMovement[]
  saleItems     SaleItem[]

  // Unicités relatives à un magasin
  @@unique([sku, storeId])
  @@unique([barcode, storeId])
  @@index([storeId, quantity])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  storeId   Int
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  quantity  Int
  type      MovementType
  note      String?
  createdAt DateTime     @default(now())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  storeId   Int
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
}

// Vente globale (Ticket / Facture)
model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique // Ex: FAC-20260731-0001
  totalAmount   Float
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())

  userId        Int           // Le Caissier / Utilisateur qui a réalisé la vente
  user          User          @relation(fields: [userId], references: [id])
  storeId       Int
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items         SaleItem[]

  @@index([storeId, createdAt])
  @@index([userId])
}

// Détail des articles vendus dans une facture
model SaleItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Float   // Prix unitaire au moment de la vente
  total     Float   // quantity * unitPrice

  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @db.VarChar(3)
  toCurrency   String   @db.VarChar(3)
  rate         Float
  source       String   @default("OPENEXCHANGERATES") @db.VarChar(50)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}