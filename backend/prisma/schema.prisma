generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum MovementType {
  CREATION
  RECHARGE
  SALE
  ADJUSTMENT
}

enum Currency {
  XOF
  EUR
  USD
  GBP
  NGN
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  password        String
  role            UserRole  @default(ADMIN)
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Traçabilité : Si l'Admin créateur est supprimé, les comptes créés le sont aussi
  createdById     Int?
  createdBy       User?     @relation("UserCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdUsers    User[]    @relation("UserCreator")

  // Magasins dont cet utilisateur est LE PROPRIÉTAIRE (Suppression en cascade si l'admin est supprimé)
  ownedStores     Store[]   @relation("StoreOwner")

  // Magasin auquel cet utilisateur est AFFECTÉ (Suppression de l'employé si le magasin est supprimé)
  assignedStoreId Int?
  assignedStore   Store?    @relation("AssignedEmployees", fields: [assignedStoreId], references: [id], onDelete: Cascade)

  // Assignations multiples
  storeAssignments StoreAssignment[] @relation("UserStoreAssignments")

  resetToken      ResetToken?
  stockMovements  StockMovement[]
  sales           Sale[]
  auditLogs       AuditLog[]
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id            Int               @id @default(autoincrement())
  name          String
  location      String?
  phone         String?
  currency      Currency          @default(XOF)
  createdAt     DateTime          @default(now())

  // Propriétaire
  userId        Int
  owner         User              @relation("StoreOwner", fields: [userId], references: [id], onDelete: Cascade)

  // Employés rattachés
  employees     User[]            @relation("AssignedEmployees")

  assignedUsers StoreAssignment[] @relation("StoreAssignments")

  products      Product[]
  sales         Sale[]
  categories    Category[]
  suppliers     Supplier[]
  stockMovements StockMovement[]
  notifications Notification[]
}

model StoreAssignment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation("UserStoreAssignments", fields: [userId], references: [id], onDelete: Cascade)

  storeId   Int
  store     Store    @relation("StoreAssignments", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  sku          String?
  barcode      String?
  imageUrl     String?
  quantity     Int       @default(0)
  initialStock Int       @default(0)

  minimumStock Int       @default(5)
  safetyStock  Int       @default(2)
  optimalStock Int?

  purchasePrice Float
  sellingPrice  Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId   Int?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements    StockMovement[]
  saleItems    SaleItem[]

  @@unique([sku, storeId])
  @@unique([barcode, storeId])
  @@index([storeId, quantity])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  storeId   Int
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  quantity  Int
  type      MovementType
  note      String?
  createdAt DateTime     @default(now())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   Int
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
}

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  totalAmount   Float
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())

  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId       Int
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items         SaleItem[]

  @@index([storeId, createdAt])
  @@index([userId])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Float
  total     Float

  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @db.VarChar(3)
  toCurrency   String   @db.VarChar(3)
  rate         Float
  source       String   @default("OPENEXCHANGERATES") @db.VarChar(50)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}