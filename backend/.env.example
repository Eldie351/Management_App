# Copiez ce fichier en ".env" (cp .env.example .env) puis renseignez vos
# propres valeurs. Ce fichier est utilisé pour un lancement "hors Docker"
# (npm run start:dev / npm run start:prod).
#
# Avec docker-compose (voir le README à la racine du projet), DATABASE_URL
# est fourni automatiquement à partir des variables POSTGRES_* du fichier
# ".env" situé à la racine du dépôt — vous n'avez pas besoin de dupliquer
# ces valeurs ici pour utiliser Docker.

# Application
PORT=3001
NODE_ENV=development

# Base de données (Prisma)
# Exemple pour un PostgreSQL local, ou une base managée (Neon, Supabase, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/management_app?schema=public"
# sslmode=verify-full&connect_timeout=30&pool_timeout=30
# Authentification JWT
# Obligatoire : le serveur refuse de démarrer sans cette variable.
# Générez une valeur forte, ex : openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# Frontend (utilisé pour construire le lien de réinitialisation de mot de passe)
FRONTEND_URL="http://localhost:3000"
# En développement (NODE_ENV=development), le lien est de toute façon renvoyé
# dans la réponse API. Ne passez cette variable à "true" en production.
SHOW_RESET_LINK="false"

# Emails transactionnels (Resend) - optionnel
# Sans clé, le lien de réinitialisation est simplement affiché dans les logs serveur
RESEND_API_KEY=
EMAIL_FROM="Octostock <onboarding@resend.dev>"

# Taux de change - optionnel (voir EXCHANGE_RATE_SETUP.md)
OPENEXCHANGERATES_API_KEY=
